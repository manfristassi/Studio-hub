<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>Mini Slither</title>

<style>

* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #07111c;
    font-family: Arial, sans-serif;
    color: white;
}

body {
    display: flex;
    align-items: center;
    justify-content: center;
}

#gameWrap {
    position: relative;
    width: min(100vw, 1000px);
    height: min(100vh, 700px);
    background: #091a27;
    overflow: hidden;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
}

/* HUD */

#hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;

    height: 64px;

    background: rgba(5, 12, 20, 0.92);

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 18px;

    z-index: 3;

    border-bottom: 1px solid rgba(255,255,255,0.08);
}

.stat {
    font-weight: bold;
    font-size: 18px;
}

.lives {
    letter-spacing: 3px;
    color: #ff5964;
}

/* Suggerimento */

#hint {
    position: absolute;

    bottom: 10px;
    left: 50%;

    transform: translateX(-50%);

    font-size: 13px;

    color: #aab8c7;

    z-index: 3;

    text-align: center;

    pointer-events: none;
}

/* MENU */

#menu,
#gameOver {
    position: absolute;

    inset: 64px 0 0;

    background: rgba(3,9,15,0.88);

    display: flex;

    align-items: center;
    justify-content: center;

    z-index: 5;
}

.panel {
    width: min(90%, 500px);

    text-align: center;

    padding: 34px 28px;

    border: 1px solid rgba(255,255,255,0.12);

    border-radius: 24px;

    background: #102231;

    box-shadow: 0 18px 60px rgba(0,0,0,0.35);
}

h1 {
    margin: 0 0 10px;

    font-size: 48px;
}

.sub {
    color: #aebdca;

    margin: 0 0 26px;
}

button {
    border: 0;

    border-radius: 14px;

    padding: 14px 24px;

    font-size: 18px;

    font-weight: bold;

    cursor: pointer;

    background: #49d17d;

    color: #06120b;
}

button:active {
    transform: scale(0.97);
}

/* GAME OVER */

#gameOver {
    display: none;
}

.big {
    font-size: 52px;

    color: #ff6973;

    margin: 0 0 10px;
}

#finalScore {
    font-size: 22px;

    margin-bottom: 24px;
}

/* CONTROLLI TOUCH */

#touch {
    display: none;

    position: absolute;

    bottom: 28px;
    left: 50%;

    transform: translateX(-50%);

    z-index: 4;

    width: 170px;
    height: 120px;
}

.tbtn {
    position: absolute;

    width: 52px;
    height: 52px;

    border-radius: 50%;

    background: rgba(255,255,255,0.13);

    border: 1px solid rgba(255,255,255,0.16);

    color: white;

    font-size: 24px;

    display: flex;

    align-items: center;
    justify-content: center;

    user-select: none;
}

#up {
    left: 59px;
    top: 0;
}

#left {
    left: 0;
    top: 58px;
}

#down {
    left: 59px;
    top: 58px;
}

#right {
    right: 0;
    top: 58px;
}

/* MOBILE */

@media (pointer: coarse), (max-width: 700px) {

    #touch {
        display: block;
    }

    #hint {
        bottom: 8px;
        font-size: 11px;
    }

    h1 {
        font-size: 40px;
    }

    .stat {
        font-size: 15px;
    }
}

</style>
</head>

<body>

<div id="gameWrap">

    <canvas id="game"></canvas>

    <!-- HUD -->

    <div id="hud">

        <div class="stat">
            🏆 <span id="score">0</span>
        </div>

        <div class="stat">
            ❤️
            <span id="lives" class="lives">
                ♥ ♥ ♥
            </span>
        </div>

        <div class="stat">
            📏 <span id="length">8</span>
        </div>

    </div>


    <!-- MENU -->

    <div id="menu">

        <div class="panel">

            <h1>
                🐍 Mini Slither
            </h1>

            <p class="sub">
                Mangia il cibo, cresci e cerca
                di non schiantarti!
            </p>

            <button id="startBtn">
                GIOCA
            </button>

            <p class="sub" style="margin:20px 0 0">

                WASD / frecce

                <br>

                Su iPad usa i pulsanti

            </p>

        </div>

    </div>


    <!-- GAME OVER -->

    <div id="gameOver">

        <div class="panel">

            <p class="big">
                GAME OVER
            </p>

            <div id="finalScore">
                Punteggio: 0
            </div>

            <button id="restartBtn">
                RICOMINCIA
            </button>

        </div>

    </div>


    <!-- CONTROLLI TOUCH -->

    <div id="touch">

        <div class="tbtn" id="up">
            ▲
        </div>

        <div class="tbtn" id="left">
            ◀
        </div>

        <div class="tbtn" id="down">
            ▼
        </div>

        <div class="tbtn" id="right">
            ▶
        </div>

    </div>


    <div id="hint">

        Mangia ● • Evita ◆ • Bordo = perdi una vita

    </div>

</div>


